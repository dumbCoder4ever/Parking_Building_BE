# =========================================================
# ENVIRONMENT VARIABLES - Railway Deployment
# =========================================================
# Copy values into Railway Dashboard → Variables (do not commit secrets)

# ==================== Database ====================
# Use Railway MySQL reference variables or paste connection details
SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PORT>/railway
SPRING_DATASOURCE_USERNAME=<MYSQL_USERNAME>
SPRING_DATASOURCE_PASSWORD=<MYSQL_PASSWORD>

# ==================== JWT ====================
JWT_SECRET=8f4a1b9c2d7e6f5a4b3c2d1e9f8a7b6c123456789abcdef
JWT_EXPIRATION=86400000

# ==================== Frontend ====================
FRONTEND_URL=https://parking-building-management.vercel.app

# ==================== Cloudinary ====================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==================== VNPay ====================
VNPAY_TMN_CODE=<VNPAY_TMN_CODE>
VNPAY_HASH_SECRET=<VNPAY_HASH_SECRET>
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://parkingbuildingbe-production.up.railway.app/api/payments/vnpay/return
VNPAY_IPN_URL=https://parkingbuildingbe-production.up.railway.app/api/payments/vnpay/ipn

# ==================== PayOS ====================
# Credentials: https://my.payos.vn
PAYOS_CLIENT_ID=<PAYOS_CLIENT_ID>
PAYOS_API_KEY=<PAYOS_API_KEY>
PAYOS_CHECKSUM_KEY=<PAYOS_CHECKSUM_KEY>
PAYOS_RETURN_URL=https://parkingbuildingbe-production.up.railway.app/api/payments/payos/return
PAYOS_CANCEL_URL=https://parkingbuildingbe-production.up.railway.app/api/payments/payos/cancel
# Webhook on my.payos.vn:
# https://parkingbuildingbe-production.up.railway.app/api/payments/payos/webhook

# ==================== Mail ====================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=<YOUR_EMAIL@gmail.com>
SPRING_MAIL_PASSWORD=<APP_PASSWORD>
SPRING_MAIL_PORT=587

# ==================== Plate Recognizer OCR ====================
PLATE_RECOGNIZER_API_KEY=<YOUR_PLATE_RECOGNIZER_API_KEY>

# ==================== Server ====================
SERVER_PORT=8080
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ALLOWED_ORIGINS=*
