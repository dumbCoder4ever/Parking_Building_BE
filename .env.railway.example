# =========================================================
# ENVIRONMENT VARIABLES - Railway Deployment
# =========================================================
# Copy file này thành .env và điền giá trị thật

# ==================== Database ====================
# Lấy từ Railway MySQL Connection String
SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PORT>/railway
SPRING_DATASOURCE_USERNAME=<MYSQL_USERNAME>
SPRING_DATASOURCE_PASSWORD=<MYSQL_PASSWORD>

# ==================== JWT ====================
# Secret key cho JWT (nên dài >= 32 ký tự)
JWT_SECRET=8f4a1b9c2d7e6f5a4b3c2d1e9f8a7b6c123456789abcdef
JWT_EXPIRATION=86400000

# ==================== Cloudinary ====================
# Lấy từ https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==================== VNPay ====================
# Sandbox: https://sandbox.vnpayment.vn/
# Production: https://vnpayment.vn/
VNPAY_TMN_CODE=<VNPAY_TMN_CODE>
VNPAY_HASH_SECRET=<VNPAY_HASH_SECRET>
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://your-domain.com/api/payments/vnpay/return
VNPAY_IPN_URL=https://your-domain.com/api/payments/vnpay/ipn

# ==================== PayOS ====================
# Lấy từ https://my.payos.vn
PAYOS_CLIENT_ID=<PAYOS_CLIENT_ID>
PAYOS_API_KEY=<PAYOS_API_KEY>
PAYOS_CHECKSUM_KEY=<PAYOS_CHECKSUM_KEY>
PAYOS_RETURN_URL=https://your-domain.com/api/payments/payos/return
PAYOS_CANCEL_URL=https://your-domain.com/api/payments/payos/cancel

# ==================== Mail ====================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=<YOUR_EMAIL@gmail.com>
SPRING_MAIL_PASSWORD=<APP_PASSWORD>

# ==================== FPT.AI OCR ====================
# API Key từ https://fpt.ai/
FPT_AI_API_KEY=c0WXiFmRoccngoLy80ndy0JzAhcidoDK

# ==================== Server ====================
PORT=8080
